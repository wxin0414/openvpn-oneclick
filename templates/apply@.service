[Unit]
Description=ovpn-oneclick 特权助手分发器（每连接一实例）
Documentation=https://github.com/wxin0414/openvpn-oneclick
# 由 apply.socket（Accept=yes）为每个连接拉起一个实例，处理完即退出。
# 以 root 运行**无需** sudo —— 这是绕开 NoNewPrivileges 限制的关键。

[Service]
Type=exec
StandardInput=socket
StandardOutput=socket
StandardError=journal
ExecStart=/usr/local/lib/ovpnmanager/apply-dispatch

User=root
Group=root
# 不要加 PrivateTmp=yes。升级走的是"服务里派生一个脱离会话的后台进程"，
# 而 PrivateTmp 会让该服务的 /tmp 与 /var/tmp 成为私有 tmpfs —— 服务一退出，
# 目录就消失，仍在运行的后台进程执行 mktemp 时直接失败（实测：
# mktemp: failed to create file via template '/tmp/tmp.XXXXXXXXXX'）。
# 这个助手本来就是 root 且只按白名单动作执行，不需要靠私有 tmp 隔离。
NoNewPrivileges=no
# 客户端不发数据就一直挂着连接时，由这里兜底杀掉
TimeoutStartSec=60
KillMode=process
