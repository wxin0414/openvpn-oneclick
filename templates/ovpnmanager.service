[Unit]
Description=OpenVPN Web Admin Panel (ovpnmanager)
After=network-online.target
Wants=network-online.target
After=__OVPN_SERVICE__.service

[Service]
Type=simple
User=__PANEL_USER__
Group=__PANEL_USER__
WorkingDirectory=__PANEL_HOME__/backend
EnvironmentFile=__PANEL_HOME__/backend/.env
# --workers 1 是刻意的：面板使用 SQLite，且进程内维护 management 连接复用、
# TTL 缓存、熔断状态与证书签发后台任务队列；多 worker 会各存一份并争抢写锁。
ExecStart=__PANEL_HOME__/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port __PANEL_PORT__ --workers 1 --no-server-header
Restart=on-failure
RestartSec=3
TimeoutStopSec=15

# ---- 加固 ----
# 注意：**不要**在这里加 NoNewPrivileges=true 或 RestrictSUIDSGID=true。
# 本面板的设计是"以非 root 运行 + 用 sudo 调用受控助手"：
#   * systemctl 包装脚本（查状态 / 起停 OpenVPN）
#   * apply-config（落地「服务端设置」页面改的配置）
# 两者都依赖 sudo 的 setuid 提权。NoNewPrivileges=true 会让服务内的 sudo 永远失败，
# 表现为面板把运行中的服务误报成 unknown、「服务端设置」保存直接失败。
# 实测踩过这个坑：shell 里手工 sudo 通，服务里全挂。
PrivateTmp=true
# ProtectSystem=yes 只把 /usr 挂成只读；**不能用 full/strict**，
# 它们会连 /etc 一起挂只读，而 root 助手需要写 /etc/openvpn/server.conf、
# /etc/sudoers.d 与 /etc/nginx —— sudo 之后的进程仍在同一挂载命名空间里，
# 下面的 ReadWritePaths 救不了它（那些路径也会被设成只读+可写叠加，语义混乱）。
ProtectSystem=yes
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true
# 面板新建的文件默认私有（数据库、日志）。注意：必须由 OpenVPN 读取的
# 文件（CRL、CCD）在代码里显式 chmod 0644，不受这里的 umask 影响。
UMask=0077
# 面板自身需要写入的位置（证书体系、CCD、客户端导出、状态日志等）
ReadWritePaths=/etc/openvpn
ReadWritePaths=/var/log/openvpn
ReadWritePaths=__PANEL_HOME__/backend/data
ReadWritePaths=__PANEL_HOME__/logs

[Install]
WantedBy=multi-user.target
