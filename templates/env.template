# ovpnmanager 面板环境变量（由 ovpn-oneclick 安装脚本生成）
# 权限 0600，属主为面板专用用户。SECRET_KEY 与初始口令在安装时随机生成。

# ---- 应用 ----
APP_NAME=OpenVPN Web Admin
# PROD 会关闭 /docs、/redoc，并启用严格 CORS
DEPLOY_ENV=PROD
LOG_LEVEL=INFO
LOG_FILE=__PANEL_HOME__/logs/ovpnmanager.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ---- 安全 ----
SECRET_KEY=__SECRET_KEY__
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=__ADMIN_PASSWORD__
ACCESS_TOKEN_EXPIRE_MINUTES=120
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=300
FORCE_PASSWORD_CHANGE=true

# ---- 数据库 ----
# SQLITE_PATH 与 OVPNM_DB_PATH 都识别（前者优先）
SQLITE_PATH=__PANEL_HOME__/backend/data/app.db

# ---- OpenVPN ----
OPENVPN_SERVICE_NAME=__OVPN_SERVICE__
# 降权：只允许操作上面这一个服务的包装脚本
SYSTEMCTL_BIN=__SYSTEMCTL_BIN__
OPENVPN_BASE_PATH=/etc/openvpn
EASYRSA_PATH=__EASYRSA_PATH__
CCD_PATH=__CCD_PATH__
OPENVPN_STATUS_PATH=__STATUS_PATH__
OPENVPN_CRL_PATH=__CRL_PATH__
OPENVPN_CLIENT_EXPORT_PATH=__EXPORT_PATH__
TA_KEY_PATH=__TA_KEY_PATH__
SERVER_CONF_PATH=__SERVER_CONF_PATH__

# ---- management 接口（面板在线状态/强制下线依赖）----
OPENVPN_MANAGEMENT_HOST=127.0.0.1
OPENVPN_MANAGEMENT_PORT=__MGMT_PORT__
OPENVPN_MANAGEMENT_TIMEOUT=2.0
OPENVPN_STATUS_CACHE_TTL=3.0
OPENVPN_MANAGEMENT_COOLDOWN=5.0

# ---- 客户端导出 ----
PUBLIC_IP=__PUBLIC_IP__
PUBLIC_PORT=__VPN_PORT__

# ---- 吊销行为 ----
# 只断开被吊销客户端的会话，不影响其他在线用户
REVOKE_KICKS_SESSION=true
# 默认不重启服务：OpenVPN 会在 CRL 变化后的新连接中重新读取
REVOKE_RESTARTS_SERVICE=false

# ---- 后台任务 ----
BACKGROUND_STATUS_SYNC=true
STATUS_SYNC_INTERVAL_SECONDS=30
# 证书签发走后台任务，面板必须单进程运行（systemd 单元已固定 --workers 1）

# ---- 外部命令超时（秒）----
SYSTEMCTL_TIMEOUT=20
EASYRSA_TIMEOUT=300
OPENSSL_TIMEOUT=30

# ---- CORS ----
# 面板与 API 同源部署（nginx 反代 /api），不会产生预检请求
CORS_ORIGINS=["http://localhost:8010","http://127.0.0.1:8010"]
CORS_MAX_AGE=600
