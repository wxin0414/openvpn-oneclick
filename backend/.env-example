# 面板后端环境变量示例
#
# ⚠️ 这个文件是**模板**，会随仓库公开。请勿在此填写任何真实密钥、口令或公网地址。
# 复制为 .env 后必须替换 SECRET_KEY 与 DEFAULT_ADMIN_PASSWORD，可以：
#     cp .env-example .env
#     sed -i "s|^SECRET_KEY=.*|SECRET_KEY=$(openssl rand -hex 32)|" .env
# 或者直接用 deploy/install.sh（会自动生成随机的 SECRET_KEY 与管理员口令）。

# ---- 应用 ----
APP_NAME=OpenVPN Web Admin
# DEV 会开启 /docs 与宽松 CORS；生产请用 PROD
DEPLOY_ENV=PROD
LOG_LEVEL=INFO
LOG_FILE=./logs/ovpnmanager.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ---- 安全 ----
# 必须替换。仓库历史里出现过的值（qa111-... / change-me-in-prod）是公开的，
# 用它们等于把管理员 Token 的签名密钥交给所有人。
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
DEFAULT_ADMIN_USERNAME=admin
# 仅在首次启动种子化管理员时生效；库已存在后改这里不会影响已有口令
DEFAULT_ADMIN_PASSWORD=change-me-strong-password
ACCESS_TOKEN_EXPIRE_MINUTES=120
# 登录暴力破解防护
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=300
FORCE_PASSWORD_CHANGE=true

# ---- 数据库 ----
# SQLITE_PATH 与 OVPNM_DB_PATH 都能识别（前者优先）。
# 注意 OVPNM_DB_PATH 同时被 app/scripts/tls_verify.py 读取，若使用 tls-verify
# 钩子，请确保两者指向同一个库。
SQLITE_PATH=./data/app.db

# ---- OpenVPN ----
OPENVPN_SERVICE_NAME=openvpn@server
# 降权部署时指向受限包装脚本（见 deploy/templates/systemctl-wrapper.sh）
SYSTEMCTL_BIN=systemctl
OPENVPN_BASE_PATH=/etc/openvpn
EASYRSA_PATH=/etc/openvpn/easy-rsa
CCD_PATH=/etc/openvpn/ccd
OPENVPN_STATUS_PATH=/var/log/openvpn/openvpn-status.log
OPENVPN_CRL_PATH=/etc/openvpn/server/crl.pem
OPENVPN_CLIENT_EXPORT_PATH=/etc/openvpn/client-configs
TA_KEY_PATH=/etc/openvpn/server/ta.key
SERVER_CONF_PATH=/etc/openvpn/server.conf

# ---- management 接口 ----
OPENVPN_MANAGEMENT_HOST=127.0.0.1
OPENVPN_MANAGEMENT_PORT=7505
# 单条命令的 socket 超时（秒）
OPENVPN_MANAGEMENT_TIMEOUT=2.0
# 只读探测结果缓存秒数（同一页面的重复探测会被合并）
OPENVPN_STATUS_CACHE_TTL=3.0
# 不可达后的熔断秒数：期间快速失败，不再逐个等超时
OPENVPN_MANAGEMENT_COOLDOWN=5.0

# ---- 客户端导出 ----
# 客户端连接使用的公网地址/端口；留空则使用数据库里的服务器记录
PUBLIC_IP=
PUBLIC_PORT=1194

# ---- 吊销行为 ----
# 只断开被吊销客户端的会话，不影响其他在线用户
REVOKE_KICKS_SESSION=true
# 默认不重启服务（重启会断开所有在线用户）。仅当所用 OpenVPN 版本不会自动
# 重读变化后的 CRL 时才改为 true。
REVOKE_RESTARTS_SERVICE=false

# ---- 后台任务 ----
# 在线状态同步在后台线程执行，GET /clients 保持只读
BACKGROUND_STATUS_SYNC=true
STATUS_SYNC_INTERVAL_SECONDS=30
# 证书签发/吊销走后台任务（单 worker 串行，避免并发写坏 EasyRSA PKI），
# 因此面板必须保持单进程运行（uvicorn --workers 1）。

# ---- 外部命令超时（秒）----
SYSTEMCTL_TIMEOUT=20
EASYRSA_TIMEOUT=300
OPENSSL_TIMEOUT=30

# ---- CORS ----
# 推荐用 nginx 同源反代 /api，这样浏览器不会发预检请求
CORS_ORIGINS=["http://localhost:8010","http://127.0.0.1:8010"]
CORS_MAX_AGE=600
